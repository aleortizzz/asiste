VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# YouTube Data API v3 — restringida por HTTP referrer en Google Cloud
# Console (ver supabase/migrations/20260924_canciones_plan.sql). Sin esto
# la sección de canciones no muestra resultados de búsqueda.
VITE_YOUTUBE_API_KEY=

# Client ID de Google (público) para el botón «Continuar con Google». Sin él, el botón va por Supabase.
VITE_GOOGLE_CLIENT_ID=
